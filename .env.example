# Public hostnames are hardcoded in the service configuration files.

# Required secrets. Replace every value before production use.
POSTGRES_PASSWORD=replace-with-a-long-random-password
NEXTAUTH_SECRET=replace-with-a-long-random-secret
HEADPLANE_COOKIE_SECRET=replace-with-32-char-secret-here

# Rootful Rocky Linux / Podman socket.
CONTAINER_SOCKET=/run/podman/podman.sock
