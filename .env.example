# Canonical public URLs. These values drive both Caddy and application config.
HEADSCALE_SITE=https://headscale.example.com
HEADPLANE_SITE=https://headplane.example.com
ZTNET_SITE=https://ztnet.example.com

# Headscale MagicDNS domain. It must differ from HEADSCALE_SITE.
HEADSCALE_BASE_DOMAIN=tailnet.example.com

# Required secrets. Replace every value before production use.
POSTGRES_PASSWORD=replace-with-a-long-random-password
NEXTAUTH_SECRET=replace-with-a-long-random-secret
HEADPLANE_COOKIE_SECRET=replace-with-a-long-random-secret

# Rootful Rocky Linux / Podman socket.
CONTAINER_SOCKET=/run/podman/podman.sock
