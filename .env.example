# Public hostnames are hardcoded in the service configuration files.

# Required secrets. Replace every value before production use.
POSTGRES_PASSWORD=replace-with-a-long-random-password
NEXTAUTH_SECRET=replace-with-a-long-random-secret
HEADPLANE_COOKIE_SECRET=replace-with-32-char-secret-here
# Optional password required when creating SMP relay queues.
SMP_PASSWORD=
# XFTP file storage quota and optional upload password.
XFTP_QUOTA=15gb
XFTP_PASSWORD=

# Set CONTAINER_SOCKET in the shell to $XDG_RUNTIME_DIR/podman/podman.sock.
