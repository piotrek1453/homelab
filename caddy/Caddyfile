headscale.cdreamz.duckdns.org {
    reverse_proxy headscale:8080
}

headplane.cdreamz.duckdns.org {
    @root path /
    redir @root /admin/ 302
    reverse_proxy headplane:3000
}

ztnet.cdreamz.duckdns.org {
    reverse_proxy ztnet:3000
}

smp.cdreamz.duckdns.org {
    reverse_proxy https://smp-server:5223 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}

